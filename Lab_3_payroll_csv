import csv
import os

FILENAME = "payroll.csv"
FIELDS = ["Employee ID", "Name", "Basic Salary", "Allowance", "Deduction", "Net Salary"]


def add_employee():
    """Accept employee details, calculate net salary, and store in CSV"""
    try:
        emp_id = input("Enter Employee ID: ").strip()
        name = input("Enter Employee Name: ").strip()
        basic = float(input("Enter Basic Salary: ").strip())
        allowance = float(input("Enter Allowance: ").strip())
        deduction = float(input("Enter Deduction: ").strip())

        # Calculate Net Salary
        net_salary = basic + allowance - deduction

        # Check if file exists to decide whether to write header
        file_exists = os.path.isfile(FILENAME)

        with open(FILENAME, mode="a", newline="") as file:
            writer = csv.writer(file)

            # Write header only if file is new
            if not file_exists:
                writer.writerow(FIELDS)

            # Write employee record
            writer.writerow([emp_id, name, basic, allowance, deduction, net_salary])

        print(f"\nEmployee record added successfully!")
        print(f"Net Salary calculated: {net_salary:.2f}\n")

    except ValueError:
        print("Error: Please enter valid numeric values for salary, allowance, and deduction.\n")
    except Exception as e:
        print(f"An error occurred: {e}\n")


def display_payroll():
    """Read and display all employee payroll records from the CSV file"""
    try:
        with open(FILENAME, mode="r", newline="") as file:
            reader = csv.reader(file)
            records = list(reader)

            if len(records) <= 1:  # Only header or empty
                print("No employee records found.\n")
                return

            print("\n" + "=" * 85)
            print(f"{'Employee ID':<15} {'Name':<20} {'Basic':<12} {'Allowance':<12} {'Deduction':<12} {'Net Salary':<12}")
            print("=" * 85)

            # Skip header and print data rows
            for row in records[1:]:
                if len(row) == 6:
                    print(f"{row[0]:<15} {row[1]:<20} {float(row[2]):<12.2f} {float(row[3]):<12.2f} {float(row[4]):<12.2f} {float(row[5]):<12.2f}")

            print("=" * 85 + "\n")

    except FileNotFoundError:
        print("No payroll records found. The file does not exist yet.\n")
    except Exception as e:
        print(f"An error occurred while reading the file: {e}\n")


def main():
    """Main menu-driven program"""
    while True:
        print("===== CSV-Based Payroll Management System =====")
        print("1. Add Employee Record")
        print("2. Display Payroll Records")
        print("3. Exit")

        choice = input("Enter your choice (1-3): ").strip()

        if choice == "1":
            add_employee()
        elif choice == "2":
            display_payroll()
        elif choice == "3":
            print("Exiting the program. Goodbye!")
            break
        else:
            print("Invalid choice! Please enter 1, 2, or 3.\n")


if __name__ == "__main__":
    main()