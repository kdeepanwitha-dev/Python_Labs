import os
from datetime import date

FILENAME = "attendance.txt"

def add_student():
    name = input("Enter Student Name: ").strip()
    roll = input("Enter Roll Number: ").strip()

    if not name or not roll:
        print("Name and Roll Number are required!\n")
        return

    # Check if student already exists
    if os.path.exists(FILENAME):
        with open(FILENAME, "r") as file:
            for line in file:
                if line.startswith(roll + ","):
                    print("Student with this Roll Number already exists!\n")
                    return

    with open(FILENAME, "a") as file:
        file.write(f"{roll},{name},0,0\n")  # roll, name, present_count, total_days

    print("Student added successfully!\n")


def mark_attendance():
    if not os.path.exists(FILENAME):
        print("No students found. Please add students first.\n")
        return

    today = str(date.today())
    print(f"\nMarking Attendance for: {today}")
    print("-" * 40)

    updated_records = []

    with open(FILENAME, "r") as file:
        for line in file:
            roll, name, present, total = line.strip().split(",")
            present = int(present)
            total = int(total)

            status = input(f"{name} ({roll}) - Present (P) / Absent (A): ").strip().upper()

            if status == "P":
                present += 1
            total += 1

            updated_records.append(f"{roll},{name},{present},{total}")

    # Write updated data back
    with open(FILENAME, "w") as file:
        for record in updated_records:
            file.write(record + "\n")

    print("\nAttendance marked successfully!\n")


def view_attendance():
    if not os.path.exists(FILENAME):
        print("No attendance records found.\n")
        return

    print("\n" + "=" * 65)
    print(f"{'Roll No':<12} {'Name':<20} {'Present':<10} {'Total':<10} {'Percentage'}")
    print("=" * 65)

    with open(FILENAME, "r") as file:
        for line in file:
            roll, name, present, total = line.strip().split(",")
            present = int(present)
            total = int(total)

            percentage = (present / total * 100) if total > 0 else 0
            print(f"{roll:<12} {name:<20} {present:<10} {total:<10} {percentage:.1f}%")

    print("=" * 65 + "\n")


def main():
    while True:
        print("===== Attendance Tracker =====")
        print("1. Add Student")
        print("2. Mark Attendance")
        print("3. View Attendance Report")
        print("4. Exit")

        choice = input("Enter your choice (1-4): ").strip()

        if choice == "1":
            add_student()
        elif choice == "2":
            mark_attendance()
        elif choice == "3":
            view_attendance()
        elif choice == "4":
            print("Exiting the program. Goodbye!")
            break
        else:
            print("Invalid choice! Please try again.\n")


if __name__ == "__main__":
    main()